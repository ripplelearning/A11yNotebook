{
  "name": "a11y-notebook",
  "productName": "A11y Notebook",
  "version": "0.1.0",
  "private": true,
  "description": "Accessibility-first personal knowledge management desktop application for notes, tasks, documents, and research.",
  "author": {
    "name": "ripplelearning",
    "url": "https://github.com/ripplelearning"
  },
  "license": "MIT",
  "homepage": "https://github.com/ripplelearning/A11yNotebook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ripplelearning/A11yNotebook.git"
  },
  "bugs": {
    "url": "https://github.com/ripplelearning/A11yNotebook/issues"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron && wait-on tcp:127.0.0.1:5173 && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:shortcuts": "node scripts/generate-shortcuts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && electron-builder --win --publish never",
    "release:win": "npm run build && electron-builder --win --publish always",
    "test:ui-smoke": "powershell -ExecutionPolicy Bypass -File scripts/windows-ui-automation-smoke.ps1"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "epubjs": "^0.4.2",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.0"
  },
  "overrides": {
    "epubjs": {
      "xmldom": "npm:@xmldom/xmldom@0.8.15"
    }
  }
}
